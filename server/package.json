{
  "name": "@notes/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify-indexes": "node --env-file=.env --import tsx scripts/verify-indexes.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^9.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0"
  }
}
