{
  "name": "senotely",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --recursive --parallel --filter @senotely/server --filter @senotely/web dev",
    "dev:full": "docker compose up -d && pnpm dev",
    "dev:web": "pnpm --filter @senotely/web dev",
    "dev:server": "pnpm --filter @senotely/server dev",
    "build": "pnpm --filter @senotely/server build && pnpm --filter @senotely/web build",
    "lint": "eslint server && pnpm --filter @senotely/web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @senotely/server typecheck && pnpm --filter @senotely/web exec tsc --noEmit",
    "test": "pnpm --filter @senotely/server test",
    "seed": "pnpm --filter @senotely/server seed",
    "explain": "pnpm --filter @senotely/server explain"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
